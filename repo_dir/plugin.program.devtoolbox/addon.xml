<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.devtoolbox" name="Dev ToolBox" version="1.0.0" provider-name="Twilight0">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.qrcode" version="6.1.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="router.py">
        <provides>executable</provides>
    </extension>
    <extension point="kodi.context.item">
        <menu id="kodi.core.main">
            <item library="context_entry.py">
                <label>Dev Toolbox</label>
                <visible>true</visible>
            </item>
        </menu>
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <reuselanguageinvoker>false</reuselanguageinvoker>
        <summary lang="en_GB">Swiss army knife for Kodi developers and power users</summary>
        <description lang="en_GB">Dev Toolbox is a modular Kodi development suite featuring an in-GUI code/text editor, live debug toggles (Kodi log, skin debug, reload skin), an addon inspector, a log viewer with QR code upload, and a dedicated custom WindowXML keymap editor.</description>
        <license>GPL-3.0-only</license>
        <source>https://github.com/Twilight0/plugin.program.devtoolbox</source>
        <assets>
            <icon>resources/media/icon_default.png</icon>
            <fanart>resources/media/fanart_default.jpg</fanart>
        </assets>
    </extension>
</addon>
